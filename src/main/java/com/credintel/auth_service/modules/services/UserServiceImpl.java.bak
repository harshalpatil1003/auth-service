package com.credintel.auth_service.modules.services;

import com.credintel.auth_service.modules.bean.User;
import com.credintel.auth_service.modules.dao.RoleDao;
import com.credintel.auth_service.modules.dao.UserDao;
import com.credintel.auth_service.modules.dto.*;
import com.credintel.base.constants.BaseEntityConstants;
import com.credintel.base.utility.BaseUtility;
import com.credintel.common.RoleDTO;
import com.credintel.common.UserDTO;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.ArrayList;
import java.util.List;

@Service
public class UserServiceImpl implements UserService{

    @Autowired
    UserDao userDao;

    @Autowired
    RoleDao roleDao;

    @Override
    public UserDTO getUserByEmailId(String emailId) throws Exception {
        if(isUserExists(emailId)){
            User user = userDao.getUserByEmailId(emailId);

            return convertBeanToDTO(user);
        }else{
            throw new Exception("Invalid Email user");
        }
    }

    @Override
    public String getUserPassword(String emailId) throws Exception {
        if(isUserExists(emailId)){
            User user = userDao.getUserByEmailId(emailId);
            return user.getPassword();
        }else{
            throw new Exception("Invalid Email user");
        }
    }

    @Override
    public UserDTO createUser(CreateUserRequest createUserRequest) throws Exception {
        if(isUserExists(createUserRequest.getEmail())){
            throw new Exception("User Already Exists");
        }
        
        User user = new User();
        user.setEmail(createUserRequest.getEmail());
        user.setPassword(createUserRequest.getPassword());

         List<String> userRoles = createUserRequest.getRoles();
         List<UserRoleRelation> userRoleRelationList = new ArrayList<>();
         for(String roleName : userRoles){
             Role role = roleDao.getRoleByName(roleName);
             UserRoleRelation relation = new UserRoleRelation();
             relation.setUser(user);
             relation.setRole(role);
             BaseUtility.setBaseEntityDetails(relation, 1, BaseEntityConstants.CREATE_OPERATION);
             userRoleRelationList.add(relation);
         }

        user.setUserRoleRelationList(userRoleRelationList);

         BaseUtility.setBaseEntityDetails(user, 1,BaseEntityConstants.CREATE_OPERATION);

         userDao.saveOrUpdate(user);

        return convertBeanToDTO(user);
    }

    @Override
    public Boolean isUserExists(String emailId) {
        return userDao.isUserExists(emailId);
    }


    private UserDTO convertBeanToDTO(User user){
        UserDTO userDTO = new UserDTO();
        userDTO.setEmail(user.getEmail());
        userDTO.setEnabled(user.getEnabled());

        List<RoleDTO> roleDTOList = new ArrayList<>();
        for(UserRoleRelation relation :user.getUserRoleRelationList()){
            roleDTOList.add(convertBeanToDTO(relation.getRole()));
        }
        userDTO.setRoles(roleDTOList);
        return userDTO;
    }

    private RoleDTO convertBeanToDTO(Role role){
        RoleDTO roleDTO = new RoleDTO();
        roleDTO.setId(role.getId());
        roleDTO.setName(role.getName());
        return  roleDTO;
    }

}
