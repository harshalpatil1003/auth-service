package com.credintel.auth_service.modules.services;

import com.credintel.auth_service.config.util.TokenUtil;
import com.credintel.auth_service.modules.dto.JwtAuthResponse;
import com.credintel.auth_service.modules.dto.LoginRequest;
import com.credintel.common.UserDTO;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class AuthServiceImpl implements AuthService {

    @Autowired
    UserService userService;

    @Autowired
    TokenUtil tokenUtil;

    @Override
    @Transactional
    public JwtAuthResponse validateLoginRequest(LoginRequest loginRequest) throws Exception {
        if(loginRequest.getEmail()!=null && !loginRequest.getEmail().isEmpty()){
            String password = userService.getUserPassword(loginRequest.getEmail());

            if(password.equals(loginRequest.getPassword())){
                UserDTO userDTO = userService.getUserByEmailId(loginRequest.getEmail());

                String accessToken = tokenUtil.generateAccessToken(userDTO);
                String refreshToken = tokenUtil.generateRefreshToken(userDTO);
                return new JwtAuthResponse(accessToken, refreshToken, userDTO);
            }else{
                throw new Exception("Invalid Password");
            }
        }else{
            throw new Exception("Invalid Input Email Id");
        }
    }

    @Override
    public JwtAuthResponse refreshToken(String refreshToken) throws Exception {
        if (!tokenUtil.isRefreshToken(refreshToken)) {
            throw new RuntimeException("Invalid refresh token");
        }

        String username = tokenUtil.extractUsername(refreshToken);
        UserDTO userDTO = userService.getUserByEmailId(username);

        String newAccessToken = tokenUtil.generateAccessToken(userDTO);

        return new JwtAuthResponse(newAccessToken, refreshToken, userDTO);
    }
}
